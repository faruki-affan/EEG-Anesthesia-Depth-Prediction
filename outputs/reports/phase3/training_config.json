{
  "random_state": 42,
  "clip_predictions": true,
  "log1p_skew_threshold": 1.0,
  "random_forest": {
    "n_estimators": 200,
    "max_depth": 15,
    "min_samples_leaf": 5,
    "n_jobs": -1
  },
  "hist_gradient_boosting": {
    "max_iter": 200,
    "learning_rate": 0.05,
    "max_leaf_nodes": 31,
    "early_stopping": false
  },
